    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react-dom": "^19.2.0",
    "tsx": "^4.19.4",
    "typescript": "^6.0.2"
  }
}
