{
  "id": "video.motion-transfer",
  "version": "1.0.0",
  "status": "draft",
  "domain": "video",
  "summary": "Transfer the motion of a driving video onto one or more reference character images, producing a new video of the reference character performing the driving motion.",
  "inputs": [
    { "name": "drivingVideo", "mediaType": "video/mp4", "cardinality": "one", "constraints": ">= 480p, <= 4K; the motion source" },
    { "name": "characterImages", "mediaType": "image/png", "cardinality": "one-or-more", "constraints": "full-body or half-body reference; frontal preferred" }
  ],
  "outputs": [
    { "name": "resultVideo", "mediaType": "video/mp4", "cardinality": "one", "constraints": "duration/fps follow the driving video" }
  ],
  "parameters": [
    { "name": "preserveAudio", "type": "boolean", "default": false, "description": "Carry the driving video's audio track." },
    { "name": "resolution", "type": "enum", "enumValues": ["480p", "720p", "1080p", "4k"], "default": "720p", "description": "Output resolution class." }
  ],
  "qualityDimensions": [
    { "id": "motion-fidelity", "description": "Driving motion reproduced faithfully.", "scale": "0-100" },
    { "id": "identity-preservation", "description": "Reference character identity preserved.", "scale": "0-100" },
    { "id": "temporal-coherence", "description": "Flicker/coherence across frames.", "scale": "0-100" }
  ],
  "costModel": { "pricingUnit": "per-second-of-output", "currency": "USD", "notes": "Premium providers bill per output second; open models bill compute-minutes." },
  "latencyClass": "minutes",
  "providerMappings": [
    { "providerId": "higgsfield", "modelId": "genjutsu", "executionAdapter": "higgsfield-http", "maturity": "reference", "conformanceStatus": "self-verified", "notes": "Endpoint path doc-confirmed: /higgsfield/genjutsu/motion-transfer/v1.0. Conformance recorded in mock mode; live calibration pending." },
    { "providerId": "wan-2.2", "modelId": "animate", "executionAdapter": "wan-open-exec", "maturity": "experimental", "conformanceStatus": "self-verified", "notes": "Mock-mode conformance; open execution transport." },
    { "providerId": "vace", "executionAdapter": "vace-open-exec", "maturity": "experimental", "conformanceStatus": "unverified" }
  ],
  "conformance": {
    "scenarios": [
      { "id": "motion-fidelity-basic", "path": "packages/media-capabilities/src/domain/conformance/video.motion-transfer/motion-fidelity-basic.json" }
    ],
    "certification": "self"
  },
  "notes": "Higgsfield Genjutsu motion transfer is the reference behavior; payload shape grounded in the public API docs (video_url + image_urls)."
}
