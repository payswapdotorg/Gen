{
  "id": "basic-render",
  "capabilityId": "editor.render-project",
  "description": "Render a 2s project (single clip, 320x240/25fps) to mp4 and verify job lifecycle (running → succeeded), output artifact registration with lineage, and output duration in [1.9s, 2.1s] where the adapter's render binary is present.",
  "requiresBinaries": {
    "fixtureGeneration": ["ffmpeg"],
    "render": {
      "ffmpeg": ["ffmpeg"],
      "mlt": ["melt"],
      "blender": ["blender"],
      "kdenlive": ["melt", "kdenlive_render"]
    }
  },
  "adaptersUnderTest": ["ffmpeg", "mlt", "blender", "kdenlive"],
  "fixture": {
    "kind": "ffmpeg-generated",
    "generationArgs": [
      "-f", "lavfi", "-i", "testsrc2=duration=2:size=320x240:rate=25",
      "-c:v", "libx264", "-preset", "ultrafast", "-pix_fmt", "yuv420p"
    ],
    "mediaType": "video/mp4",
    "probeMetadata": { "durationSeconds": 2, "fps": 25, "width": 320, "height": 240 }
  },
  "params": { "format": "mp4", "resolution": "320x240" },
  "expectedInvariants": {
    "jobLifecycle": ["running", "succeeded"],
    "output": {
      "exists": true,
      "durationSecondsRange": [1.9, 2.1],
      "lineage": { "capabilityId": "editor.render-project", "derivedFromNonEmpty": true }
    }
  },
  "notes": "Binary-gated per adapter; skipped adapters are reported, never claimed."
}
