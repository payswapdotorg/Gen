    "kind": "ffmpeg-generated",
    "generationArgs": ["-f", "lavfi", "-i", "testsrc2=duration=2:size=320x240:rate=25", "-c:v", "libx264", "-preset", "ultrafast", "-pix_fmt", "yuv420p"],
    "mediaType": "video/mp4",
    "probeMetadata": { "durationSeconds": 2, "fps": 25, "width": 320, "height": 240 }
  },
  "params": { "property": "opacity", "keyframes": "0=0;1=1;2=0", "interpolation": "linear", "target": "clip-0" },
  "expectedInvariants": {
    "nativeRoundTrip": { "curveCount": 1, "keyTimesSeconds": [0, 1, 2], "keyValues": [0, 1, 0] },
