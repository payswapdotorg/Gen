# 线上地址参考。按需复制到 .env；部署覆盖也可放在未跟踪的 .env.local 中。
ZCODE_BASE_URL=https://zcode.z.ai
BIGMODEL_API_BASE_URL=https://bigmodel.cn
ZAI_OAUTH_ORIGIN=https://chat.z.ai
ZAI_BUSINESS_BASE_URL=https://api.z.ai
# 线上公开 OAuth client id，不是 secret。
ZAI_OAUTH_CLIENT_ID=client_P8X5CMWmlaRO9gyO-KSqtg
ZCODE_CDN_BASE_URL=https://cdn-zcode.z.ai

# 导入会话的来源回链 base，不改变 API；保留 /cn/share，不含分享码。
# 修改 API origin 时同步修改此值，或删除此项以自动跟随 API origin；不要赋空值。
ZCODE_CONVERSATION_SHARE_WEB_URL=https://zcode.z.ai/cn/share
# 远程资源完整覆盖地址，必须包含与运行版本匹配的版本号；删除此项可自动按版本推导。
ZCODE_REMOTE_ASSET_CDN_BASE_URL=https://cdn-zcode.z.ai/zcode/electron/releases/3.14.0

# 可选本地 Provider 配置文件路径；留空使用内置线上配置。
ZCODE_BUILTIN_PROVIDER_CONFIG_FILE=

# 内网或私有部署地址没有线上默认值，按需显式填写。
ZCODE_DEPS_BASE_URL=
INTRANET_MACHINE_HOST=
ZCODE_DIST_BASE_URL=

# ==========================================================================
# Gen Creative Intelligence OS (Phase 0) — names ONLY (lock P8).
# Never commit values. The operator provisions real credentials.
# ==========================================================================

# --- Media providers ---
HIGGSFIELD_API_KEY=             # Higgsfield API credential (operator-provisioned)

# --- Model routing (agent bodies' cognitive models) ---
OPENROUTER_API_KEY=             # OpenRouter gateway key
DASHSCOPE_API_KEY=              # Alibaba Bailian / DashScope key

# --- Remote execution (optional tiers) ---
E2B_API_KEY=
COMPOSIO_API_KEY=

# --- Infra (Phase 2: creative-workspace) ---
NEON_API_KEY=
PAYSWAP_VERCEL_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
R2_S3_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Realtime / comms (Phase 2) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
RESEND_API_KEY=

# --- Repository access (CI / integration station; NEVER in the repo) ---
# PAYSWAP_PAT=                 # operator-held; granted transiently to workers
